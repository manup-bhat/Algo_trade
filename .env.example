# ═══════════════════════════════════════════════════════════════════
# KITE CONNECT CREDENTIALS
# ═══════════════════════════════════════════════════════════════════
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback
KITE_TOKEN_PATH=.kite_token

# ═══════════════════════════════════════════════════════════════════
# INFRASTRUCTURE
# ═══════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./trading.db
UNIVERSE_FILE=universe.txt

# ═══════════════════════════════════════════════════════════════════
# GROUP A: STRATEGY FILTER VALUES
# ═══════════════════════════════════════════════════════════════════
VOLUME_SPIKE_MULTIPLE=15.0
VOLUME_SMA_PERIOD=500
MIN_TURNOVER_CRORE=8.0
MIN_PRICE=50.0
MAX_PRICE=5000.0
# Re-ignition: new candle volume > REIGNITION_VOLUME_MULTIPLE × mean(all_dryup_candles)
REIGNITION_VOLUME_MULTIPLE=2.0
REIGNITION_LOOKBACK_CANDLES=3
# When true: use mean(all_dryup_candles) as reference; false = legacy max(last_3)
REIGNITION_USE_AVG_VOLUME=true
# Re-ignition candle must be >= this % of the original impact volume
REIGNITION_MIN_PCT_OF_IMPACT=0.08
MIN_DRYUP_CANDLES=2
ASHAPE_RED_CANDLE_PCT=0.5
ASHAPE_VOLUME_MULTIPLE=1.5
ASHAPE_MIN_CANDLE_COUNT=2
# Abandon if any candle volume > this fraction of impact candle AND candle is bearish
ASHAPE_IMPACT_VOLUME_PCT=0.70

# Historical warmup — sliding window configuration
HISTORICAL_WARMUP_ENABLED=true
HISTORICAL_WARMUP_TRADING_DAYS=3
HISTORICAL_WARMUP_CONCURRENCY=8
HISTORICAL_WARMUP_BATCH_DELAY_SEC=0.2
HISTORICAL_WARMUP_RECENT_CANDLES=180

# ═══════════════════════════════════════════════════════════════════
# GROUP B: SEBI / REGULATORY VALUES
# Review after every Union Budget
# ═══════════════════════════════════════════════════════════════════
STT_INTRADAY_SELL_PCT=0.00025
NSE_TXFEE_PER_LAKH_INR=3.25
SEBI_TXFEE_PER_CRORE_INR=10.0
GST_ON_BROKERAGE_PCT=18.0
STAMP_DUTY_BUY_PCT=0.00003

# ═══════════════════════════════════════════════════════════════════
# GROUP C: BROKER / API OPERATIONAL VALUES
# ═══════════════════════════════════════════════════════════════════
BROKERAGE_PER_ORDER_INR=20.0
ORDER_MAX_RETRIES=3
ORDER_RETRY_BASE_DELAY_SEC=0.5
WS_MAX_RECONNECT_ATTEMPTS=10
WS_RECONNECT_DELAY_SEC=5
MAX_WS_INSTRUMENTS=3000
EXIT_SL_CANCEL_DELAY_MS=500

# ═══════════════════════════════════════════════════════════════════
# GROUP D: STRATEGY CALIBRATION VALUES
# Tune after accumulating 50+ live trades
# ═══════════════════════════════════════════════════════════════════
DRYUP_MAX_MINUTES=25
MAX_ENTRY_TIME=13:30
ENTRY_BUFFER_PCT=0.001
ENTRY_WIDEN_AFTER_SECONDS=5
ENTRY_ABANDON_PCT=0.015
ORDER_FILL_TIMEOUT_SECONDS=30
# Skip all candles before this minute (09:30 default) — NSE opening noise guard
SCANNER_START_MINUTE=30
# Abandonment price buffer — candle wick penetration tolerance
ABANDON_PRICE_BUFFER_PCT=0.003

# ── Second spike detection (Wyckoff secondary test) ──────────────
SECOND_SPIKE_MIN_RATIO=0.50
SECOND_SPIKE_MAX_RATIO=1.00
SECOND_SPIKE_MIN_GAP_MINUTES=15
SECOND_SPIKE_VOLUME_FLOOR=10.0
SECOND_SPIKE_PRICE_ABOVE_HIGH_THRESHOLD=0.80

# ── Re-entry after abandonment (Second Chance Scanner) ───────────
RE_ENTRY_ENABLED=true
RE_ENTRY_MIN_GAP_MINUTES=15
RE_ENTRY_VOLUME_MULTIPLE=5.0
RE_ENTRY_MAX_PER_SYMBOL=2

# ═══════════════════════════════════════════════════════════════════
# MARKET DIRECTION GATE (Nifty EMA gate)
# Blocks Phase 2 entries when Nifty is below its N-period 5-min EMA
# ═══════════════════════════════════════════════════════════════════
NIFTY_GATE_ENABLED=true
NIFTY_EMA_PERIOD=20
# Kite instrument tokens (standard NSE values — do not change)
NIFTY_INSTRUMENT_TOKEN=256265
VIX_INSTRUMENT_TOKEN=264969
# VIX-aware turnover filter (high-VIX sessions get stricter turnover threshold)
HIGH_VIX_THRESHOLD=20.0
HIGH_VIX_TURNOVER_CRORE=12.0

# ═══════════════════════════════════════════════════════════════════
# GROUP E: MARKET STRUCTURE VALUES
# ═══════════════════════════════════════════════════════════════════
MARKET_OPEN_TIME=09:15
SQUARE_OFF_TIME=15:20
MASS_SQUAREOFF_START_TIME=15:18
SESSION_END_TIME=15:25

# ═══════════════════════════════════════════════════════════════════
# RISK CONTROLS
# ═══════════════════════════════════════════════════════════════════
RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=3.0
MIN_RISK_PER_SHARE_INR=5.0
PEAK_MARGIN_SAFETY_BUFFER_PCT=15.0

# ═══════════════════════════════════════════════════════════════════
# SERVER & OPERATIONAL
# ═══════════════════════════════════════════════════════════════════
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
PAPER_TRADE=false
# When true, backend process will spawn engine.runner automatically on startup.
AUTO_START_ENGINE_WITH_BACKEND=true
# If backend auto-started the engine, stop that child when backend exits.
AUTO_STOP_ENGINE_WITH_BACKEND=true
# Optional custom command to launch engine; default is: <python> -m engine.runner
ENGINE_RUNNER_CMD=
