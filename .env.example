# ═══════════════════════════════════════════════════════════════════
# KITE CONNECT CREDENTIALS
# ═══════════════════════════════════════════════════════════════════
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback
KITE_TOKEN_PATH=.kite_token

# ═══════════════════════════════════════════════════════════════════
# INFRASTRUCTURE
# ═══════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./trading.db
UNIVERSE_FILE=universe.txt

# ═══════════════════════════════════════════════════════════════════
# HISTORICAL WARMUP (engine-wide — applies to all strategies)
# ═══════════════════════════════════════════════════════════════════
HISTORICAL_WARMUP_ENABLED=true
HISTORICAL_WARMUP_TRADING_DAYS=3
HISTORICAL_WARMUP_CONCURRENCY=8
HISTORICAL_WARMUP_BATCH_DELAY_SEC=0.2
HISTORICAL_WARMUP_RECENT_CANDLES=180

# ═══════════════════════════════════════════════════════════════════
# GROUP B: SEBI / REGULATORY COST CONSTANTS
# Review after every Union Budget
# Budget 2026: equity intraday STT unchanged; options STT raised to 0.15% flat
# ═══════════════════════════════════════════════════════════════════
STT_INTRADAY_SELL_PCT=0.00025
NSE_TXFEE_PER_LAKH_INR=3.25
SEBI_TXFEE_PER_CRORE_INR=10.0
GST_ON_BROKERAGE_PCT=18.0
STAMP_DUTY_BUY_PCT=0.00003

# ═══════════════════════════════════════════════════════════════════
# GROUP C: BROKER / API OPERATIONAL
# ═══════════════════════════════════════════════════════════════════
BROKERAGE_PER_ORDER_INR=20.0
ORDER_MAX_RETRIES=3
ORDER_RETRY_BASE_DELAY_SEC=0.5
WS_MAX_RECONNECT_ATTEMPTS=10
WS_RECONNECT_DELAY_SEC=5
MAX_WS_INSTRUMENTS=3000
EXIT_SL_CANCEL_DELAY_MS=500

# ═══════════════════════════════════════════════════════════════════
# NSE INSTRUMENT TOKENS
# Fixed NSE constants — same for every Kite account, do not change
# Used engine-wide by the Coordinator (market gate, VIX feed)
# ═══════════════════════════════════════════════════════════════════
NIFTY_INSTRUMENT_TOKEN=256265
VIX_INSTRUMENT_TOKEN=264969

# ═══════════════════════════════════════════════════════════════════
# STRATEGY SELECTION
# Comma-separated strategy IDs to enable (must match engine/strategies/<id>)
# Each strategy also needs `enabled: true` in its own config.yaml
# ═══════════════════════════════════════════════════════════════════
ENABLED_STRATEGIES=ivbs

# ═══════════════════════════════════════════════════════════════════
# GROUP E: MARKET STRUCTURE TIMES
# ═══════════════════════════════════════════════════════════════════
MARKET_OPEN_TIME=09:15
SQUARE_OFF_TIME=15:20
MASS_SQUAREOFF_START_TIME=15:18
SESSION_END_TIME=15:25

# ═══════════════════════════════════════════════════════════════════
# RISK CONTROLS (global — applies across all strategies combined)
# ═══════════════════════════════════════════════════════════════════
RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=3.0
MIN_RISK_PER_SHARE_INR=5.0
PEAK_MARGIN_SAFETY_BUFFER_PCT=15.0

# ═══════════════════════════════════════════════════════════════════
# TRADE MODE
# PAPER       — simulated fills using live LTP, no Kite orders placed
# LIVE        — real Kite orders, dashboard approval required
# SIMULTANEOUS — alternates PAPER/LIVE per signal (shadow trading)
# ═══════════════════════════════════════════════════════════════════
TRADE_MODE=PAPER
PAPER_TRADE=false

# ═══════════════════════════════════════════════════════════════════
# SERVER & OPERATIONAL
# ═══════════════════════════════════════════════════════════════════
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# Engine subprocess management
AUTO_START_ENGINE_WITH_BACKEND=true
AUTO_STOP_ENGINE_WITH_BACKEND=true
# Optional custom command to launch engine; default: <python> -m engine.runner
ENGINE_RUNNER_CMD=

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: Strategy-specific settings (scanner thresholds, dry-up timing,
# re-ignition, a-shape guard, second-spike, re-entry, market gate / VIX gate)
# are configured per-strategy in:
#   engine/strategies/ivbs/config.yaml
#   engine/strategies/<other_strategy>/config.yaml
# ─────────────────────────────────────────────────────────────────────────────
